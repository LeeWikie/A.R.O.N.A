{
  "name": "arona",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "cli": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "start": "node --env-file-if-exists=.env dist/server.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/provider": "4.0.35",
    "@hono/node-server": "2.1.5",
    "@mastra/core": "1.81.0",
    "@mastra/libsql": "1.28.0",
    "@mastra/memory": "1.40.0",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
