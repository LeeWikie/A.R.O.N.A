# Configure all four model values together, or leave them unset and use the CLI.
# SHITTIMCHEST_MODEL_PROTOCOL=responses
# SHITTIMCHEST_MODEL_BASE_URL=http://127.0.0.1:8000/v1
# SHITTIMCHEST_MODEL_ID=
# SHITTIMCHEST_MODEL_API_KEY=
# SHITTIMCHEST_MODEL_AUTH_HEADER=api-key
# SHITTIMCHEST_MODEL_REASONING_EFFORT=none
# SHITTIMCHEST_PORT=4111
# SHITTIMCHEST_DATA_DIR=
# SHITTIMCHEST_TIMEZONE=Asia/Shanghai
# SHITTIMCHEST_CONCURRENCY=4
# SHITTIMCHEST_MAX_STEPS=64
# SHITTIMCHEST_MEMORY_ENABLED=true
# SHITTIMCHEST_CONTROL_TOKEN=
