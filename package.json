{
  "name": "arona",
  "version": "0.1.1-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "cli": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/write-build-info.mjs && node scripts/copy-licenses.mjs && node scripts/prepare-fd.mjs && node scripts/prepare-rg.mjs",
    "package": "pnpm build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --expose-gc --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:live": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test:behavior": "node --import tsx scripts/compare-behavior.ts",
    "test:endurance": "node --import tsx scripts/endurance.ts",
    "test:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/provider": "4.0.35",
    "@earendil-works/pi-ai": "1.5.1",
    "@earendil-works/pi-coding-agent": "1.5.1",
    "@earendil-works/pi-tui": "1.5.1",
    "@hono/node-server": "2.1.5",
    "@inquirer/password": "5.2.5",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@mastra/core": "1.81.0",
    "@mastra/libsql": "1.28.0",
    "@mastra/mcp": "2.7.0",
    "@mastra/memory": "1.40.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@mozilla/readability": "0.6.0",
    "croner": "10.0.1",
    "eventsource-parser": "3.0.6",
    "exceljs": "4.4.0",
    "file-type": "21.0.0",
    "fossil-delta": "2.0.0",
    "highlight.js": "10.7.3",
    "hono": "4.13.14",
    "ignore": "7.0.14",
    "ipaddr.js": "2.4.0",
    "js-tiktoken": "1.0.21",
    "linkedom": "0.18.12",
    "mammoth": "1.13.0",
    "marked": "15.0.12",
    "minimatch": "11.0.3",
    "pdf-parse": "2.4.5",
    "proper-lockfile": "4.1.2",
    "turndown": "7.2.0",
    "undici": "8.12.2",
    "uri-template": "2.0.0",
    "yaml": "2.9.1",
    "yauzl": "3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/turndown": "5.0.5",
    "@types/ws": "8.18.2",
    "@types/yauzl": "2.10.3",
    "@xterm/headless": "5.5.0",
    "chalk": "6.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  },
  "bin": {
    "shittimchest": "dist/cli.js",
    "arona": "dist/cli.js",
    "shittimchest-core": "dist/server.js"
  },
  "files": [
    "dist/**",
    "README.md",
    ".env.example"
  ],
  "bundleDependencies": [
    "@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui",
    "@lydell/node-pty",
    "@mastra/core",
    "@mastra/libsql",
    "fossil-delta",
    "@modelcontextprotocol/client",
    "@mastra/mcp"
  ]
}
